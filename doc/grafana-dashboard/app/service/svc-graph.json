{
  "__inputs": [
    {
      "name": "DS_TEMPO",
      "label": "Tempo",
      "description": "",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    },
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__elements": {},
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "12.4.2"
    },
    {
      "type": "panel",
      "id": "nodeGraph",
      "name": "Node Graph",
      "version": ""
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "datasource",
      "id": "tempo",
      "name": "Tempo",
      "version": "12.4.2"
    },
    {
      "type": "panel",
      "id": "text",
      "name": "Text",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 2,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "<div>\n  <h1>Services</h1>\n  <div style=\"display:flex; gap:8px; border-bottom: 1px solid #333;\">\n    <a href=\"/d/svc-list\"\n       style=\"padding:6px 16px; color:#aaa; text-decoration:none;\">\n      Service List\n    </a>\n    <a href=\"/d/svc-graph\"\n       style=\"padding:6px 16px; color:white; text-decoration:none; border-bottom: 1px solid #ff8833;\">\n      Service Graph\n    </a>\n    <a href=\"/d/svc-trace\"\n       style=\"padding:6px 16px; color:#aaa; text-decoration:none;\">\n      Service Traces\n    </a>\n  </div>\n</div>",
        "mode": "html"
      },
      "pluginVersion": "12.4.2",
      "transparent": true,
      "type": "text"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "id": 3,
      "options": {
        "edges": {
          "mainStatUnit": ""
        },
        "layoutAlgorithm": "layered",
        "nodes": {
          "arcs": []
        },
        "zoomMode": "cooperative"
      },
      "pluginVersion": "12.4.2",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "limit": 20,
          "metricsQueryType": "range",
          "queryType": "serviceMap",
          "refId": "A",
          "serviceMapQuery": "{k8s_cluster_name=\"$cluster\"}",
          "serviceMapUseNativeHistograms": false,
          "tableType": "traces"
        }
      ],
      "transparent": true,
      "type": "nodeGraph"
    }
  ],
  "preload": false,
  "schemaVersion": 42,
  "tags": [],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(kube_pod_labels,k8s_cluster_name)",
        "includeAll": false,
        "name": "cluster",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(kube_pod_labels,k8s_cluster_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "regexApplyTo": "value",
        "type": "query"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "query_result(sum by (k8s_namespace_name) ({  __name__=~\"jvm_class_count|cpython_gc_collections_total|nodejs_eventloop_utilization_ratio\",  k8s_cluster_name=\"$cluster\",  k8s_namespace_name!=\"\"})* on (k8s_namespace_name) sum by (k8s_namespace_name) ({  __name__=\"kube_pod_labels\",  k8s_cluster_name=\"$cluster\",  k8s_namespace_name!=\"\"}))",
        "includeAll": true,
        "multi": true,
        "name": "namespace",
        "options": [],
        "query": {
          "qryType": 3,
          "query": "query_result(sum by (k8s_namespace_name) ({  __name__=~\"jvm_class_count|cpython_gc_collections_total|nodejs_eventloop_utilization_ratio\",  k8s_cluster_name=\"$cluster\",  k8s_namespace_name!=\"\"})* on (k8s_namespace_name) sum by (k8s_namespace_name) ({  __name__=\"kube_pod_labels\",  k8s_cluster_name=\"$cluster\",  k8s_namespace_name!=\"\"}))",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "/k8s_namespace_name=\"(?<text>[^\"]+)/g",
        "regexApplyTo": "value",
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Service Graph",
  "uid": "svc-graph",
  "version": 13,
  "weekStart": ""
}