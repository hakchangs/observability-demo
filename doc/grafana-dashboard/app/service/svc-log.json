          "query": "query_result(label_replace(  sum({    __name__=\"nodejs_eventloop_utilization_ratio\",    k8s_cluster_name=\"$cluster\",    k8s_namespace_name=\"$namespace\",    service_name=\"$service\"  }),  \"display_nodejs\", \"block\", \"\", \"\") or label_replace(  absent({    __name__=\"nodejs_eventloop_utilization_ratio\",    k8s_cluster_name=\"$cluster\",    k8s_namespace_name=\"$namespace\",    service_name=\"$service\"  }),  \"display_nodejs\", \"none\", \"\", \"\"))",
