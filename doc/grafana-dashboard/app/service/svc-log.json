        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "query_result(label_replace(  sum({    __name__=\"jvm_class_count\",    k8s_cluster_name=\"$cluster\",    k8s_namespace_name=\"$namespace\",    service_name=\"$service\"  }),  \"display_jvm\", \"block\", \"\", \"\") or label_replace(  absent({    __name__=\"jvm_class_count\",    k8s_cluster_name=\"$cluster\",    k8s_namespace_name=\"$namespace\",    service_name=\"$service\"  }),  \"display_jvm\", \"none\", \"\", \"\"))",
        "hide": 2,
