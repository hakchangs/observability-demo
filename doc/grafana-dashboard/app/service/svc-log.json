          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "query_result(label_replace(  sum({    __name__=\"cpython_gc_collections_total\",    k8s_cluster_name=\"$cluster\",    k8s_namespace_name=\"$namespace\",    service_name=\"$service\"  }),  \"display_python\", \"block\", \"\", \"\") or label_replace(  absent({    __name__=\"cpython_gc_collections_total\",    k8s_cluster_name=\"$cluster\",    k8s_namespace_name=\"$namespace\",    service_name=\"$service\"  }),  \"display_python\", \"none\", \"\", \"\"))",
