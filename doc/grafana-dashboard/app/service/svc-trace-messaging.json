              ],
              "valueType": "string"
            },
            {
              "id": "span-name",
              "isCustomValue": false,
              "operator": "!=",
              "scope": "span",
              "tag": "name",
              "value": [
                "GET /actuator/health"
              ],
              "valueType": "string"
            }
          ],
          "limit": 2000,
          "metricsQueryType": "range",
          "query": "{\n  resource.service.name=\"$service\"\n  && span:name!=\"\"\n  && (span.messaging.system=~\".+\" || span.messaging.operation=~\".+\")\n}\n| select(\n  span.messaging.system,\n  span.messaging.operation, span.messaging.operation.type,\n  span.messaging.operation.name,\n  span.messaging.client_id, span.messaging.client.id,\n  span.messaging.destination.name,\n  span.messaging.destination.partition.id,\n  span.messaging.kafka.consumer.group,\n  span.messaging.kafka.message.offset,\n  span.messaging.message.body.size\n)",
          "queryType": "traceql",
          "refId": "A",
          "serviceMapUseNativeHistograms": false,
          "tableType": "spans"
        }
