          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "12.4.2",
      "targets": [
        {
          "editorMode": "code",
          "expr": "(\n  sum(rate({\n    __name__=\"container_cpu_usage_seconds_total\",\n      k8s_cluster_name=\"$cluster\",\n      k8s_namespace_name=\"$namespace\",\n      k8s_pod_name!=\"\",\n      container!=\"\"\n  }[$__rate_interval])) by (k8s_pod_name)\n\n  /\n\n  sum({\n    __name__=\"kube_pod_container_resource_limits\",\n      resource=\"cpu\",\n      k8s_cluster_name=\"$cluster\",\n      k8s_namespace_name=\"$namespace\",\n      k8s_pod_name!=\"\"\n  }) by (k8s_pod_name)\n)\n* on (k8s_pod_name) group_left(label_app_kubernetes_io_name)\nlabel_replace ({\n  __name__=\"kube_pod_labels\",\n  k8s_cluster_name=\"$cluster\",\n  k8s_namespace_name=\"$namespace\",\n  k8s_pod_name!=\"\",\n  label_app_kubernetes_io_name=\"$service\"\n}, \"service_name\", \"$1\", \"label_app_kubernetes_io_name\", \"(.*)\")",
          "legendFormat": "{{k8s_pod_name}}",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "title": "CPU 사용율(%)",
      "type": "timeseries"
    },
