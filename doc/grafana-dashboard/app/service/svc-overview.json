          "editorMode": "code",
          "expr": "(\n  histogram_quantile(0.95,\n    sum by (service_name, le, k8s_cluster_name, k8s_namespace_name) (\n      rate({\n        __name__=\"http_server_request_duration_seconds_bucket\",\n        service_name=~\"$service\",\n        k8s_cluster_name=~\"$cluster\",\n        k8s_namespace_name=~\"$namespace\"\n      }[$__rate_interval])\n    )\n  )\n)\nor\n(\n  histogram_quantile(0.95,\n    sum by (service_name, le, k8s_cluster_name, k8s_namespace_name) (\n      rate({\n        __name__=\"http_server_duration_milliseconds_bucket\",\n        service_name=~\"$service\",\n        k8s_cluster_name=~\"$cluster\",\n        k8s_namespace_name=~\"$namespace\"\n      }[$__rate_interval])\n    )\n  ) / 1000\n)",
